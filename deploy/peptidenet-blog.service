[Unit]
Description=PeptideNet — blog scheduler (cadence-aware generate + auto-publish)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/peptidenet

# The same EnvironmentFile gunicorn uses. settings.py also reads .env directly
# now, so this is belt-and-braces rather than the only line of defence — but it
# is what keeps the unit honest if the file is ever moved out of BASE_DIR.
EnvironmentFile=/var/www/peptidenet/.env

# blog_tick (policy change 2026-08-12, approved by Jeff): guardrail-PASSING
# posts auto-publish on each site's 3-days-a-week cadence — backlog drafts
# first, fresh generation only when the backlog is empty. Posts that trip a
# hard guardrail still stop in needs_review for a human. The compliance
# guardrails remain the gate; do not weaken them to make a post publish.
ExecStart=/var/www/peptidenet/venv/bin/python manage.py blog_tick

Nice=10
TimeoutStartSec=900

# Same hardening posture as the web service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
